{
    "image": "mcr.microsoft.com/devcontainers/php:2.0.1-8.2",
    "postCreateCommand": "(sudo echo 'xdebug.mode=develop,debug,profile,trace,gcstats' >> /usr/local/etc/php/conf.d/xdebug.ini) && (sudo echo 'xdebug.client_port=9003' >> /usr/local/etc/php/conf.d/xdebug.ini)",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22.19.0"
        }
    },
    "forwardPorts": [9000, 9003]
}
